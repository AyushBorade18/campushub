# ================================================================
# CAMPUSHUB - ENVIRONMENT VARIABLES
# ================================================================
# STEP 1: Copy this file and rename it to:  .env.local
# STEP 2: Fill in your actual values below
# ================================================================

# --- FROM SUPABASE (supabase.com → your project → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_ANON_KEY

# --- FROM GOOGLE AI STUDIO (aistudio.google.com → Get API Key) ---
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
